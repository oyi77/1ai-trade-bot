[Unit]
Description=Vilona Trade FX Telegram Bot Handler (Legacy Full-Feature Engine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=/home/openclaw/projects/1ai-trade-bot
EnvironmentFile=/home/openclaw/projects/1ai-trade-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/openclaw/projects/1ai-trade-bot/scripts/vilona_tradefx_handler.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
