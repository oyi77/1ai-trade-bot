[Unit]
Description=Unified Bot — 1AI Agent Brand (Whitelabel)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/projects/1ai-trade-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/openclaw/projects/1ai-trade-bot/.venv/bin/python -m unified_bot.telegram.whitelabel_runner 1ai
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
