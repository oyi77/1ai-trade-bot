[Unit]
Description=Vilona TradeFX Public Dashboard
After=network.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=/home/openclaw/projects/1ai-trade-bot
Environment=PYTHONPATH=/home/openclaw/projects/1ai-trade-bot
ExecStart=/usr/bin/python3 /home/openclaw/projects/1ai-trade-bot/scripts/dashboard_server.py --port 8768 --host 0.0.0.0
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
