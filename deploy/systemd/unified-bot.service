[Unit]
Description=1ai-trade-bot — Unified Trading System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
WorkingDirectory=/home/openclaw/projects/1ai-trade-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m tradebot --host 0.0.0.0 --port 9090
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
