[Unit]
Description=TradeBot HTTP Bridge — signal relay and API gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/openclaw/projects/1ai-trade-bot
ExecStart=/home/openclaw/projects/1ai-trade-bot/.venv/bin/python -m tradebot.bridges.http_bridge
User=openclaw
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
