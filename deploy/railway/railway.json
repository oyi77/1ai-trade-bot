{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "sleepApplication": false
  },
  "variables": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONPATH": "/app",
    "TZ": "Asia/Jakarta",
    "PHANTOMFX_WEBHOOK_URL": "https://phantomfx.aitradepulse.com/id",
    "XAUUSD_PRICE_OFFSET": "74",
    "LOG_LEVEL": "INFO"
  },
  "volumes": {
    "trade-data": {
      "mountPath": "/app/data",
      "sizeGB": 1
    }
  }
}
