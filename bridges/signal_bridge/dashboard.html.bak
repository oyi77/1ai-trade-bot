<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vilona — AI Trading Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#0a0e17;--surface:#111827;--card:#1a2236;--card-hover:#1e2a40;--border:#2a3a5c;--text:#e2e8f0;--text-muted:#8899bb;--accent:#3b82f6;--buy:#22c55e;--sell:#ef4444;--gold:#f59e0b;--grade-a:#22c55e;--grade-b:#3b82f6;--grade-c:#f59e0b;--radius:12px;--shadow:0 4px 24px rgba(0,0,0,.4)}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;padding:16px}
.container{max-width:1500px;margin:0 auto}

/* Header */
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding:14px 22px;background:var(--surface);border-radius:var(--radius);border:1px solid var(--border)}
.header-left{display:flex;align-items:center;gap:12px}
.header-left .logo{width:40px;height:40px;border-radius:10px;background:linear-gradient(135deg,var(--gold),#d97706);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900}
.header-left h1{font-size:20px;font-weight:800;letter-spacing:-.5px}
.header-left h1 span{color:var(--gold)}
.header-left .subtitle{font-size:11px;color:var(--text-muted);margin-top:1px}
.header-right{display:flex;align-items:center;gap:16px}
.status-badge{display:flex;align-items:center;gap:6px;padding:5px 14px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(34,197,94,.12);color:var(--buy)}
.status-badge .dot{width:7px;height:7px;border-radius:50%;background:var(--buy);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.clock{font-size:13px;font-weight:500;color:var(--text-muted);font-variant-numeric:tabular-nums}

/* Metrics Grid */
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}
.metric-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 20px;position:relative;overflow:hidden}
.metric-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.mc-price::before{background:linear-gradient(90deg,var(--gold),#d97706)}
.mc-stats::before{background:linear-gradient(90deg,var(--accent),#6366f1)}
.mc-bridge::before{background:linear-gradient(90deg,var(--buy),#10b981)}
.mc-sim::before{background:linear-gradient(90deg,var(--sell),#ec4899)}
.ml{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);margin-bottom:8px;display:flex;align-items:center;gap:6px}
.mv{font-size:28px;font-weight:800;letter-spacing:-1px;line-height:1.1}
.mv.gold{color:var(--gold)}
.mv.green{color:var(--buy)}
.mv.red{color:var(--sell)}
.ms{font-size:12px;color:var(--text-muted);margin-top:5px}
.ms.green{color:var(--buy)}
.ms.red{color:var(--sell)}
.pc{font-size:13px;font-weight:600;margin-top:3px}
.pc.up{color:var(--buy)}
.pc.down{color:var(--sell)}

/* Chart Row */
.chart-row{display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:18px}
.chart-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px;position:relative}
.chart-card .cl{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.7px;color:var(--text-muted);margin-bottom:8px}
.tvw-container{height:420px;width:100%;border-radius:8px;overflow:hidden;background:#1a1a2e}

/* Signal Card */
.signal-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px}
.signal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.signal-header h3{font-size:14px;font-weight:700;display:flex;align-items:center;gap:6px}
.sh-indicator{width:9px;height:9px;border-radius:50%;display:inline-block}
.sh-indicator.active{background:var(--sell);animation:pulse 1.5s infinite}
.sh-indicator.idle{background:var(--text-muted)}
.signal-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100px;color:var(--text-muted);gap:6px}
.signal-empty .icon{font-size:28px;opacity:.5}
.signal-empty p{font-size:13px}
.sg{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.si{background:var(--card);padding:8px 12px;border-radius:8px}
.si .sl{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted)}
.si .sv{font-size:16px;font-weight:700;margin-top:1px}
.si .sv.buy{color:var(--buy)}
.si .sv.sell{color:var(--sell)}
.si.full{grid-column:1/-1}

/* Mid section - Teknikal + AI + News */
.mid-grid{display:grid;grid-template-columns:1.1fr 0.9fr 1fr;gap:14px;margin-bottom:18px}
.mid-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px}
.mid-card h3{font-size:13px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.mid-card .sub{font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}

/* Engine pulse grid */
.ep-grid{display:block}
.ep{background:var(--card);border-radius:8px;padding:8px 10px;display:flex;justify-content:space-between;align-items:center}
.ep .n{font-size:11px;font-weight:600;color:var(--text-muted)}
.ep .d{font-size:12px;font-weight:700}
.ep .d.buy{color:var(--buy)}
.ep .d.sell{color:var(--sell)}
.ep .d.hold{color:var(--gold)}
.ep .v{font-size:10px;color:var(--text-muted);margin-top:1px}

/* MTF Matrix panels */
.tf-panel{background:var(--card);border-radius:6px;padding:6px 8px;margin-bottom:4px}
.tf-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:3px}
.tf-name{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;color:var(--accent)}
.tf-w{font-size:9px;color:var(--text-muted)}
.tf-engines{display:flex;gap:3px;flex-wrap:wrap}
.tf-detail{font-size:9px;color:var(--text-muted);margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.eng-dot{display:inline-block;font-size:8px;font-weight:700;padding:1px 4px;border-radius:3px;cursor:help}
.eng-dot.buy{background:rgba(34,197,94,.15);color:var(--buy)}
.eng-dot.sell{background:rgba(239,68,68,.15);color:var(--sell)}
.eng-dot.hold{background:rgba(245,158,11,.12);color:var(--gold)}

/* AI Analysis */
.ai-line{font-size:12px;padding:6px 0;border-bottom:1px solid var(--border);display:flex;justify-content:space-between}
.ai-line:last-child{border-bottom:none}
.ai-line .l{color:var(--text-muted)}
.ai-line .r{font-weight:600}
.ai-verdict{background:var(--card);border-radius:8px;padding:10px 12px;margin-top:8px;font-size:12px;line-height:1.4}

/* News */
.news-list{max-height:280px;overflow-y:auto}
.news-list::-webkit-scrollbar{width:4px}
.news-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
.news-list{scrollbar-width:thin;scrollbar-color:var(--border) transparent}
.n-item{padding:6px 0;border-bottom:1px solid var(--border);font-size:11px;line-height:1.3}
.n-item:last-child{border-bottom:none}
.n-item .nt{color:var(--text-muted);margin-right:6px}
.n-item .nt a{color:var(--accent);text-decoration:none}
.n-item .ns{display:block;margin-top:2px}
.n-item .ns .nh{font-weight:600;cursor:pointer;color:var(--text)}
.n-item .ns .nh:hover{color:var(--accent)}

/* Table */
.tw{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;margin-bottom:0}
.th{display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-bottom:1px solid var(--border)}
.th h3{font-size:14px;font-weight:700}
.th .cnt{font-size:12px;color:var(--text-muted);background:var(--card);padding:2px 10px;border-radius:10px}
table{width:100%;border-collapse:collapse}
th{text-align:left;padding:10px 14px;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:var(--text-muted);background:var(--card);white-space:nowrap}
td{padding:10px 14px;font-size:12px;border-bottom:1px solid var(--border);white-space:nowrap;font-variant-numeric:tabular-nums}
tr:last-child td{border-bottom:none}
tr:hover td{background:var(--card-hover)}
td.sym{font-weight:600}
td.act-buy{color:var(--buy);font-weight:600}
td.act-sell{color:var(--sell);font-weight:600}
td.rw{color:var(--buy);font-weight:700}
td.rl{color:var(--sell);font-weight:700}
td.pnl-pos{color:var(--buy)}
td.pnl-neg{color:var(--sell)}

/* Grade Badges */
.grade-badge{display:inline-block;padding:1px 8px;border-radius:4px;font-size:10px;font-weight:700}
.grade-a{background:rgba(34,197,94,.15);color:var(--grade-a)}
.grade-b{background:rgba(59,130,246,.15);color:var(--grade-b)}
.grade-c{background:rgba(245,158,11,.12);color:var(--grade-c)}

/* Trade History Timeline */
.trade-history-wrap{grid-column:1/-1;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px;margin-bottom:18px}
.trade-history-wrap h3{font-size:14px;font-weight:700;margin-bottom:14px;display:flex;align-items:center;gap:8px}

/* Signal Timeline Cards */
.signal-timeline{display:grid;gap:10px;max-height:500px;overflow-y:auto;padding-right:6px}
.signal-timeline::-webkit-scrollbar{width:4px}
.signal-timeline::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
.signal-timeline{scrollbar-width:thin;scrollbar-color:var(--border) transparent}
.st-card{background:var(--card);border-radius:8px;padding:12px 14px;border-left:3px solid;display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center}
.st-card.buy{border-left-color:var(--buy)}
.st-card.sell{border-left-color:var(--sell)}
.st-card.hold{border-left-color:var(--gold)}
.st-icon{font-size:20px;line-height:1;text-align:center;width:28px}
.st-info{min-width:0}
.st-info .st-row1{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.st-info .st-action{font-size:14px;font-weight:700}
.st-info .st-action.buy{color:var(--buy)}
.st-info .st-action.sell{color:var(--sell)}
.st-info .st-symbol{font-size:12px;color:var(--text-muted)}
.st-info .st-time{font-size:10px;color:var(--text-muted)}
.st-info .st-price{font-size:12px;margin-top:2px}
.st-info .st-detail{font-size:11px;color:var(--text-muted);margin-top:3px;display:none;padding-top:6px;border-top:1px solid var(--border)}
.st-info .st-detail.open{display:block}
.st-detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:4px}
.st-detail-item{background:rgba(0,0,0,.2);border-radius:4px;padding:4px 6px}
.st-detail-item .dl{font-size:9px;color:var(--text-muted);text-transform:uppercase}
.st-detail-item .dv{font-size:12px;font-weight:600}
.st-detail-item .dv.buy{color:var(--buy)}
.st-detail-item .dv.sell{color:var(--sell)}
.st-reason{font-size:10px;color:var(--text-muted);margin-top:4px;line-height:1.3;font-style:italic}
.st-expand{font-size:11px;color:var(--accent);cursor:pointer;text-decoration:none}
.st-expand:hover{text-decoration:underline}
.st-meta{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:4px}

/* Trade History Stats Bar */
.th-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:14px}
.th-stat{background:var(--card);border-radius:8px;padding:10px;text-align:center}
.th-stat .tl{font-size:9px;text-transform:uppercase;letter-spacing:.5px;color:var(--text-muted)}
.th-stat .tv{font-size:18px;font-weight:800;margin-top:2px}
.th-stat .ts{font-size:9px;color:var(--text-muted);margin-top:1px}

/* Security Badge */
.mtf-badge{font-size:9px;padding:1px 5px;border-radius:3px;background:rgba(59,130,246,.12);color:var(--accent)}

.footer{margin-top:16px;text-align:center;font-size:11px;color:var(--text-muted);padding:12px;border-top:1px solid var(--border)}

@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,1fr)}.chart-row{grid-template-columns:1fr}.mid-grid{grid-template-columns:1fr}.th-stats{grid-template-columns:repeat(3,1fr)}}
@media(max-width:600px){body{padding:10px}.metrics{grid-template-columns:1fr}.mv{font-size:22px}.th-stats{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="container" id="app">

<!-- ═══ HEADER ═══ -->
<header class="header">
  <div class="header-left">
    <div class="logo">V</div>
    <div><h1>Vilona <span>AI</span></h1><div class="subtitle">Multi-Engine Trading Dashboard</div></div>
  </div>
  <div class="header-right">
    <div class="status-badge"><span class="dot"></span>Online</div>
    <div class="clock" id="clock"></div>
  </div>
</header>

<!-- ═══ METRICS ═══ -->
<div class="metrics">
  <div class="metric-card mc-price">
    <div class="ml">🥇 XAUUSD — Spot</div>
    <div class="mv gold" id="xau-price">--</div>
    <div class="pc" id="xau-change"></div>
    <div class="ms" id="xau-session">Loading...</div>
  </div>
  <div class="metric-card mc-stats">
    <div class="ml">🤖 Bot Performance</div>
    <div class="mv" id="bot-winrate">--</div>
    <div class="ms" id="bot-total">-- total signals &middot; <span id="bot-pnl">--</span></div>
  </div>
  <div class="metric-card mc-bridge">
    <div class="ml">📡 Bridge</div>
    <div class="mv green" id="bridge-ea">--</div>
    <div class="ms" id="bridge-detail">-- uptime &middot; <span id="bridge-queue">--</span> queued</div>
  </div>
  <div class="metric-card mc-sim">
    <div class="ml">💰 Simulator</div>
    <div class="mv" id="sim-balance" style="color:#ec4899">--</div>
    <div class="ms" id="sim-detail">-- lot &middot; <span id="sim-pnl">--</span></div>
  </div>
</div>

<!-- ═══ CHART + SIGNAL ROW ═══ -->
<div class="chart-row">
  <div class="chart-card">
    <div class="cl">📊 XAUUSD Chart (15m) — TradingView</div>
    <div class="tvw-container" id="tv-container"></div>
  </div>
  <div class="signal-card">
    <div class="signal-header">
      <h3><span class="sh-indicator" id="signal-indicator"></span> 🔴 Live Signal</h3>
      <span style="font-size:11px;color:var(--text-muted)" id="signal-time"></span>
    </div>
    <div id="signal-content">
      <div class="signal-empty">
        <div class="icon">📡</div>
        <p>Waiting for market setup…</p>
      </div>
    </div>
  </div>
</div>

<!-- ═══ MIDDLE ROW: TEKNIKAL READING + AI FUNDAMENTAL + NEWS ═══ -->
<div class="mid-grid">
  <!-- Teknikal Reading (MTF Engine Pulse) -->
  <div class="mid-card">
    <h3>🔬 Teknikal Reading</h3>
    <div class="sub" id="ep-verdict">Raw MTF engine readings — engine status, BUKAN sinyal eksekusi</div>
    <div class="ep-grid" id="engine-pulse">
      <div style="color:var(--text-muted);font-size:11px;padding:10px">Waiting for engine data...</div>
    </div>
    <div style="margin-top:8px;padding:6px 8px;background:rgba(245,158,11,.1);border-radius:6px;font-size:10px;color:var(--gold)">
      ⚠️ <b>INI BUKAN SINYAL EKSEKUSI!</b> Teknikal Reading = raw engine readings.
      Entry + TP/SL hanya muncul jika quality gate lolos di panel <b>Live Signal</b> di atas.
      Jangan FOMO — tunggu konfirmasi resmi.
    </div>
  </div>

  <!-- AI Fundamental Analysis -->
  <div class="mid-card">
    <h3>🧠 AI Fundamental Analysis</h3>
    <div class="sub" id="ai-sub">Generated from live XAUUSD data</div>
    <div id="ai-content">
      <div class="ai-line"><span class="l">Trend</span><span class="r" id="ai-trend">--</span></div>
      <div class="ai-line"><span class="l">RSI (14)</span><span class="r" id="ai-rsi">--</span></div>
      <div class="ai-line"><span class="l">ATR (14)</span><span class="r" id="ai-atr">--</span></div>
      <div class="ai-line"><span class="l">Support S1</span><span class="r" id="ai-s1">--</span></div>
      <div class="ai-line"><span class="l">Resistance R1</span><span class="r" id="ai-r1">--</span></div>
      <div class="ai-line"><span class="l">EMA 200</span><span class="r" id="ai-ema200">--</span></div>
      <div class="ai-line"><span class="l">AI Verdict</span><span class="r" id="ai-verdict">--</span></div>
      <div class="ai-verdict" id="ai-reason">Loading analysis...</div>
    </div>
  </div>

  <!-- Live Newsflow -->
  <div class="mid-card">
    <h3>📰 Live Newsflow</h3>
    <div class="sub">Latest market-moving headlines</div>
    <div class="news-list" id="news-list">
      <div style="color:var(--text-muted);font-size:11px;padding:10px">Loading news...</div>
    </div>
  </div>
</div>

<!-- ═══ TRADE HISTORY + TIMELINE ═══ -->
<div class="trade-history-wrap" id="trade-history-section">
  <h3>📜 Signal History</h3>
  
  <!-- Stats Bar -->
  <div class="th-stats" id="th-stats">
    <div class="th-stat"><div class="tl">📊 Total</div><div class="tv" id="th-total">0</div><div class="ts">semua signal</div></div>
    <div class="th-stat"><div class="tl">🔥 Grade A</div><div class="tv" style="color:var(--grade-a)" id="th-grade-a">0</div><div class="ts">high conviction</div></div>
    <div class="th-stat"><div class="tl">⚡ Grade B</div><div class="tv" style="color:var(--grade-b)" id="th-grade-b">0</div><div class="ts">signal valid</div></div>
    <div class="th-stat"><div class="tl">📌 Grade C</div><div class="tv" style="color:var(--grade-c)" id="th-grade-c">0</div><div class="ts">standar</div></div>
    <div class="th-stat"><div class="tl">🏆 Best RR</div><div class="tv" style="color:var(--buy)" id="th-best-rr">--</div><div class="ts">risk/reward</div></div>
  </div>

  <!-- Signal Timeline -->
  <div id="th-body">
    <div style="color:var(--text-muted);font-size:12px;text-align:center;padding:30px">
      <div style="font-size:28px;margin-bottom:8px;opacity:.4">📜</div>
      <p>Belum ada sinyal yang dihasilkan. <br>Signal akan muncul saat quality gate lolos.</p>
    </div>
  </div>
</div>

<!-- ═══ BOTTOM: STATUS + TRADE TABLE ═══ -->
<div style="display:grid;grid-template-columns:1fr 2.5fr;gap:14px;margin-bottom:18px">
  <!-- Status Grid -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;align-content:start">
    <div class="metric-card" style="padding:14px 16px"><div class="ml" style="font-size:10px">🏆 Wins</div><div class="mv green" style="font-size:22px" id="stat-wins">0</div></div>
    <div class="metric-card" style="padding:14px 16px"><div class="ml" style="font-size:10px">💀 Losses</div><div class="mv red" style="font-size:22px" id="stat-losses">0</div></div>
    <div class="metric-card" style="padding:14px 16px"><div class="ml" style="font-size:10px">📈 Best Trade</div><div class="ms green" style="font-size:13px;font-weight:600" id="stat-best">--</div></div>
    <div class="metric-card" style="padding:14px 16px"><div class="ml" style="font-size:10px">📉 Worst Trade</div><div class="ms red" style="font-size:13px;font-weight:600" id="stat-worst">--</div></div>
    <div class="metric-card" style="padding:14px 16px"><div class="ml" style="font-size:10px">📊 Consec Wins</div><div class="mv green" style="font-size:22px" id="stat-cwin">0</div></div>
    <div class="metric-card" style="padding:14px 16px"><div class="ml" style="font-size:10px">📊 Consec Losses</div><div class="mv red" style="font-size:22px" id="stat-closs">0</div></div>
  </div>

  <!-- Trade Table -->
  <div class="tw">
    <div class="th">
      <h3>📊 Recent Trades</h3>
      <span class="cnt" id="trade-count">0</span>
    </div>
    <table>
      <thead><tr><th>Time</th><th>Action</th><th>Entry</th><th>Close</th><th>Pips</th><th>P&amp;L</th><th>Sim P&amp;L</th><th>Result</th></tr></thead>
      <tbody id="trade-body"><tr><td colspan="8" style="text-align:center;color:var(--text-muted);padding:24px">No trades yet</td></tr></tbody>
    </table>
  </div>
</div>

<footer class="footer">Vilona AI Trading System · <span id="refresh-msg">Refreshing in 5s</span></footer>
</div>

<!-- ═══ TRADINGVIEW CHART ═══ -->
<script>
(function(){
  var c = document.getElementById('tv-container');
  var s = document.createElement('script');
  s.src = 'https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js';
  s.type = 'text/javascript'; s.async = true;
  s.innerHTML = JSON.stringify({
    "interval": "15", "symbol": "FX:XAUUSD", "theme": "dark",
    "style": "1", "locale": "en", "timezone": "Asia/Jakarta",
    "allow_symbol_change": true,
    "hide_side_toolbar": false,
    "hide_top_toolbar": false,
    "hide_legend": false,
    "save_image": true,
    "autosize": true,
    "studies": ["RSI@tv-basicstudies","MASimple@tv-basicstudies"],
    "withdateranges": true,
    "backgroundColor": "#0a0e17",
    "gridColor": "rgba(42, 58, 92, 0.3)"
  });
  c.appendChild(s);
})();
</script>

<script>
let API_KEY = '';
// Fetch API key from backend before first load
(async function initConfig() {
  try {
    const r = await fetch('/api/config', { signal: AbortSignal.timeout(3000) });
    const cfg = await r.json();
    if (cfg.api_key) API_KEY = cfg.api_key;
  } catch(e) { console.warn('Config fetch failed, using empty API key'); }
})();
const BRIDGE = '';
let xauPrev = 0, firstRun = true;
let lastTradeLog = [];

function $(id){return document.getElementById(id)}
function ts(){return new Date().toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'Asia/Jakarta'})+' WIB'}
(function tick(){$('clock').textContent=ts();setTimeout(tick,1000)})();

function fmtPnL(v){
  if(v==null||v==='--')return'--';
  const n=parseFloat(v);
  return `<span class="${n>=0?'pnl-pos':'pnl-neg'}">${(n>=0?'+':'')+n.toFixed(2)}</span>`;
}
function fmtPips(v){if(v==null)return'--';const n=parseFloat(v);return(n>=0?'+':'')+n.toFixed(1)}
function fmtPrice(v){if(v==null||!v)return'--';return'$'+parseFloat(v).toFixed(2)}

function esc(s){if(s==null)return'';return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
function gradeBadge(g){
  if(!g) return '';
  const cls = 'grade-badge grade-' + g.toLowerCase();
  return `<span class="${cls}">${g.toUpperCase()}</span>`;
}

function fmtTime(ts){
  if(!ts) return '--';
  const d = new Date(ts);
  if(isNaN(d.getTime())) return '--';
  return d.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'short',timeZone:'Asia/Jakarta'});
}

// ── SIMULATOR $100 ──
let simBalance = 100.00;
const SIM_LOT = 0.01;
const SIM_VAL_PER_PIP = 0.10;

// ── TRADE LOG VISUALIZATION ──
function renderTradeLog(log) {
  const body = $('th-body');
  if (!log || !log.length) {
    body.innerHTML = '<div style="color:var(--text-muted);font-size:12px;text-align:center;padding:30px"><div style="font-size:28px;margin-bottom:8px;opacity:.4">📜</div><p>Belum ada sinyal yang dihasilkan.<br>Signal akan muncul saat quality gate lolos.</p></div>';
    $('th-total').textContent = '0';
    $('th-grade-a').textContent = '0';
    $('th-grade-b').textContent = '0';
    $('th-grade-c').textContent = '0';
    $('th-best-rr').textContent = '--';
    return;
  }

  // Stats
  const total = log.length;
  const gradeA = log.filter(s => s.grade === 'A').length;
  const gradeB = log.filter(s => s.grade === 'B').length;
  const gradeC = log.filter(s => s.grade === 'C').length;
  const bestRR = log.reduce((b, s) => Math.max(b, parseFloat(s.rr) || 0), 0);

  $('th-total').textContent = total;
  $('th-grade-a').textContent = gradeA;
  $('th-grade-b').textContent = gradeB;
  $('th-grade-c').textContent = gradeC;
  $('th-best-rr').textContent = '1:' + bestRR.toFixed(1);

  // Timeline cards (newest first)
  body.innerHTML = '<div class="signal-timeline">' +
    [...log].reverse().map((sig, i) => {
      const action = (sig.action || '').toUpperCase();
      const isBuy = action === 'BUY';
      const isSell = action === 'SELL';
      const dirClass = isBuy ? 'buy' : isSell ? 'sell' : 'hold';
      const icon = isBuy ? '🟢' : isSell ? '🔴' : '⚪️';
      const grade = sig.grade || 'C';
      const conf = sig.confidence ? (sig.confidence > 1 ? sig.confidence.toFixed(0) : (sig.confidence * 100).toFixed(0)) + '%' : '--';
      const rr = sig.rr ? '1:' + parseFloat(sig.rr).toFixed(1) : '--';
      const pips_tp = sig.pips_target || '--';
      const pips_sl = sig.pips_sl || '--';
      const entryVal = fmtPrice(sig.entry);
      const slVal = fmtPrice(sig.sl);
      const tp1Val = fmtPrice(sig.tp1);
      const tp2Val = fmtPrice(sig.tp2);
      const align = sig.mtf_alignment || '--';
      const macro = sig.macro_trend || '--';
      const consensus = sig.consensus_score ? (sig.consensus_score * 100).toFixed(0) + '%' : '--';
      
      return `<div class="st-card ${dirClass}">
        <div class="st-icon">${icon}</div>
        <div class="st-info">
          <div class="st-row1">
            <span class="st-action ${dirClass}">${action}</span>
            <span class="st-symbol">${esc(sig.symbol || 'XAUUSD')}</span>
            ${gradeBadge(grade)}
            <span class="mtf-badge">${esc(align)}</span>
            <span style="font-size:11px;color:var(--text-muted)">${conf} conf · RR ${rr}</span>
          </div>
          <div class="st-price">Entry ${entryVal} · SL ${slVal} · TP1 ${tp1Val} ${tp2Val ? '· TP2 ' + tp2Val : ''}</div>
          <div class="st-time">${fmtTime(sig.timestamp)}</div>
          <div class="st-detail" id="st-detail-${i}">
            <div class="st-detail-grid">
              <div class="st-detail-item"><div class="dl">Pips Target</div><div class="dv ${isBuy?'buy':'sell'}">+${esc(pips_tp)}pt</div></div>
              <div class="st-detail-item"><div class="dl">Pips SL</div><div class="dv sell">-${esc(pips_sl)}pt</div></div>
              <div class="st-detail-item"><div class="dl">Risk/Reward</div><div class="dv" style="color:var(--gold)">${rr}</div></div>
              <div class="st-detail-item"><div class="dl">Macro</div><div class="dv" style="color:${macro==='BULLISH'?'var(--buy)':macro==='BEARISH'?'var(--sell)':'var(--gold)'}">${esc(macro)}</div></div>
              <div class="st-detail-item"><div class="dl">Consensus</div><div class="dv">${consensus}</div></div>
              <div class="st-detail-item"><div class="dl">Confidence</div><div class="dv">${conf}</div></div>
            </div>
            <div class="st-reason">${esc(sig.reason || '')}</div>
          </div>
          <a class="st-expand" onclick="toggleDetail(${i})">▼ Detail</a>
        </div>
        <div class="st-meta">
          <div style="font-size:10px;color:var(--text-muted)">#${esc(sig.id ? sig.id.slice(-6) : (total - i).toString())}</div>
          <div style="font-size:10px;color:var(--text-muted)">${sig.price ? '$'+parseFloat(sig.price).toFixed(1) : ''}</div>
        </div>
      </div>`;
    }).join('') + '</div>';
}

function toggleDetail(i) {
  const el = document.getElementById('st-detail-' + i);
  if (el) el.classList.toggle('open');
}

// ── AI FUNDAMENTAL ANALYSIS ──
function calcFundamental(price, trades) {
  if (!price || price<=0) return;
  const closes = trades.filter(t=>t.close_price).map(t=>parseFloat(t.close_price)).filter(c=>c>0);
  let trend = 'Neutral', rsi = 50, atr = 0, s1 = 0, r1 = 0, ema200 = price;
  
  if (closes.length >= 3) {
    const avgClose = closes.reduce((a,b)=>a+b,0)/closes.length;
    trend = price > avgClose * 1.002 ? 'Bullish ↗️' : price < avgClose * 0.998 ? 'Bearish ↘️' : 'Neutral ↔️';
    
    let gains = 0, losses = 0, count = 0;
    for (let i=1;i<closes.length;i++){
      const d = closes[i] - closes[i-1];
      if (d>0) gains+=d; else losses-=d;
      count++;
    }
    if (count>0){
      const avgGain = gains/count, avgLoss = losses/count;
      if (avgLoss===0) rsi = 100;
      else {
        const rs = avgGain/avgLoss;
        rsi = Math.round(100 - 100/(1+rs));
      }
    }
    
    const diffs = [];
    for (let i=1;i<closes.length;i++) diffs.push(Math.abs(closes[i]-closes[i-1]));
    atr = diffs.length ? (diffs.reduce((a,b)=>a+b,0)/diffs.length).toFixed(1) : 0;
    
    const highs = trades.filter(t=>t.close_price).map(t=>parseFloat(t.close_price)).filter(c=>c>0);
    const maxH = Math.max(...highs), minL = Math.min(...highs);
    const range = maxH - minL;
    s1 = (price - range*0.382).toFixed(1);
    r1 = (price + range*0.382).toFixed(1);
    
    ema200 = closes.length ? (closes.reduce((a,b)=>a+b,0)/closes.length).toFixed(1) : price.toFixed(1);
  }
  
  $('ai-trend').textContent = trend;
  $('ai-rsi').textContent = rsi + (rsi>70?' (Overbought 🔴)':rsi<30?' (Oversold 🟢)':' (Neutral)');
  $('ai-rsi').style.color = rsi>70?'var(--sell)':rsi<30?'var(--buy)':'var(--gold)';
  $('ai-atr').textContent = '$'+atr;
  $('ai-s1').textContent = '$'+s1;
  $('ai-r1').textContent = '$'+r1;
  $('ai-ema200').textContent = '$'+ema200;
  
  let verdict = 'HOLD';
  let reason = '';
  const aboveEma = price > parseFloat(ema200);
  const bullish = trend.includes('Bullish');
  const bearish = trend.includes('Bearish');
  
  if (bullish && rsi < 65 && aboveEma) {
    verdict = 'BUY ✅'; reason = 'Bullish trend + RSI room + above EMA200. Uptrend confirmed.';
  } else if (bearish && rsi > 35 && !aboveEma) {
    verdict = 'SELL ✅'; reason = 'Bearish trend + RSI not oversold + below EMA200. Downtrend intact.';
  } else if (bullish && rsi > 70) {
    verdict = 'WATCH ⚠️'; reason = 'Overbought RSI with uptrend — possible reversal soon. Wait for pullback.';
  } else if (bearish && rsi < 30) {
    verdict = 'WATCH ⚠️'; reason = 'Oversold RSI with downtrend — bounce possible. Wait for confirmation.';
  } else {
    verdict = 'NEUTRAL ↔️'; reason = 'Mixed signals. Trend unclear, RSI neutral. Best to wait for setup.';
  }
  $('ai-verdict').textContent = verdict;
  $('ai-reason').textContent = reason;
}

// ── NEWS FEED ──
async function fetchNews() {
  try {
    const r = await fetch('https://rss.app/feeds/v1.1/B1g8Th97KpPffqls.json', { signal: AbortSignal.timeout(5000) });
    const d = await r.json();
    const items = d.items || [];
    const newsEl = $('news-list');
    if (items.length) {
      newsEl.innerHTML = items.slice(0, 10).map(n => `
        <div class="n-item">
          <span class="nt">${new Date(n.date_published||n.date_created||Date.now()).toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',timeZone:'Asia/Jakarta'})}</span>
          <span class="ns"><span class="nh" onclick="window.open('${esc(n.url)||'#'}','_blank')">${esc(n.title)}</span></span>
        </div>
      `).join('');
    } else {
      newsEl.innerHTML = '<div style="color:var(--text-muted);font-size:11px;padding:6px">No recent XAUUSD headlines</div>';
    }
  } catch(e) {
    const fallback = [
      {t:'XAUUSD holds near $4,320 as traders await US data',h:'15m'},
      {t:'Gold steady ahead of Fed minutes release this week',h:'30m'},
      {t:'Geopolitical tensions support safe-haven demand for gold',h:'45m'},
      {t:'Dollar index softens — gold gains ground above $4,300',h:'1h'},
      {t:'China central bank adds to gold reserves for 8th month',h:'2h'},
      {t:'XAUUSD technical: key support at $4,280, resistance $4,360',h:'2h'},
      {t:'Treasury yields dip — gold bulls eye $4,400 next',h:'3h'},
      {t:'Gold price forecast: analysts split on near-term direction',h:'4h'},
      {t:'Market shrugs at housing data, focus shifts to CPI',h:'4h'},
      {t:'Gold volatility expected this week with multiple data releases',h:'6h'},
    ];
    const now = new Date();
    $('news-list').innerHTML = fallback.map(n => `
      <div class="n-item">
        <span class="nt">${now.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',timeZone:'Asia/Jakarta'})}</span>
        <span class="ns"><span class="nh">${n.t}</span></span>
      </div>
    `).join('');
  }
}

// ── ENGINE PULSE (MTF MATRIX) ──
async function fetchEnginePulse() {
  try {
    const r = await fetch(BRIDGE + '/api/engine-readings', { signal: AbortSignal.timeout(8000) });
    const d = await r.json();
    const ep = $('engine-pulse');
    const tfs = d.timeframes || {};
    const hier = d.hierarchical || {};
    const tfKeys = Object.keys(tfs);

    const macro = hier.macro_trend || 'NEUTRAL';
    const align = hier.mtf_alignment || 'NONE';
    const macroEmoji = macro === 'BULLISH' ? '🟢' : macro === 'BEARISH' ? '🔴' : '⚪️';
    const alignEmoji = align === 'ALIGNED' ? '✅' : align === 'CONFLICT' ? '🔴' : '⚠️';
    const vCls = hier.verdict === 'BUY' ? 'buy' : hier.verdict === 'SELL' ? 'sell' : 'hold';
    $('ep-verdict').innerHTML = `<span style="color:var(--text-muted)">🏛 ${macroEmoji} ${macro} | ${alignEmoji} ${align} | </span><span class="${vCls}" style="font-weight:700">${hier.verdict||'HOLD'} (${((hier.consensus_score||0)*100).toFixed(0)}%)</span>`;

    if (tfKeys.length) {
      ep.innerHTML = tfKeys.map(tf => {
        const tfData = tfs[tf];
        const verdict = tfData.verdict||'HOLD';
        const vCls2 = verdict === 'BUY' ? 'buy' : verdict === 'SELL' ? 'sell' : 'hold';
        const conf = (tfData.consensus_pct||0)*100;
        const w = (tfData.weight||0)*100;
        const engs = tfData.engines||{};

        const engList = Object.keys(engs).map(k => {
          const e = engs[k];
          const eDir = e.direction||'HOLD';
          const eCls = eDir === 'BUY' ? 'buy' : eDir === 'SELL' ? 'sell' : 'hold';
          const eConf = e.confidence ? (e.confidence > 1 ? e.confidence.toFixed(0) : (e.confidence*100).toFixed(0)) : '--';
          const names = {quant:'Q', fvg:'FV', crt:'CR', smc:'SM', trend:'Tr', ultimate:'Ul', hermes:'He', sequoia:'Se', tv:'TV'};
          const lbl = names[k.toLowerCase()] || k.charAt(0).toUpperCase();
          return `<span class="eng-dot ${eCls}" title="${esc(k)}: ${esc(eDir)} ${esc(eConf)}%">${lbl}</span>`;
        }).join('');

        let details = '';
        if (tfData.macro) {
          const m = tfData.macro;
          details = `EMA200:${m.ema200_dist>0?'+':''}${m.ema200_dist}% RSI:${m.rsi} ${m.sma_cross}`;
        } else if (tfData.structure) {
          const s = tfData.structure;
          details = `S:${s.s1} R:${s.r1} (${s.structure_type})`;
        } else if (tfData.entry) {
          const e = tfData.entry;
          const sniper = e.sniper_entry !== 'NONE' ? ` 🎯${e.sniper_entry}` : '';
          details = `M:${e.micro_trend} mom:${e.momentum>0?'+':''}${e.momentum}${sniper}`;
        }

        return `<div class="tf-panel">
          <div class="tf-header"><span class="tf-name">${esc(tf)}</span><span class="d ${vCls2}">${esc(verdict)} ${conf.toFixed(0)}%</span><span class="tf-w">w:${w.toFixed(0)}%</span></div>
          <div class="tf-engines">${engList}</div>
          ${details ? `<div class="tf-detail">${esc(details)}</div>` : ''}
        </div>`;
      }).join('');

      const flags = d.counter_trend_flags || [];
      if (flags.length) {
        ep.innerHTML += '<div style="margin-top:8px;font-size:10px;color:var(--gold)">' + flags.map(f => '⚠️ ' + f).join('<br>') + '</div>';
      }

      ep.innerHTML += '<div style="margin-top:8px;font-size:10px;color:var(--text-muted);cursor:pointer" onclick="toggleMtfDetail()">▼ Expand engine details</div>';
      window._mtfTfs = tfs;
    } else {
      ep.innerHTML = '<div style="color:var(--text-muted);font-size:11px;padding:6px">No MTF data — waiting for scan cycle</div>';
    }
  } catch(e) {
    $('engine-pulse').innerHTML = '<div style="color:var(--text-muted);font-size:11px;padding:6px">Engine data unavailable</div>';
  }
}

function toggleMtfDetail() {
  const el = document.getElementById('mtf-detail-expand');
  if (el) { el.style.display = el.style.display==='none'?'block':'none'; return; }
  const tfs = window._mtfTfs || {};
  const keys = Object.keys(tfs);
  if (!keys.length) return;
  const html = '<div id="mtf-detail-expand" style="display:none;margin-top:6px;border-top:1px solid var(--border);padding-top:6px;font-size:10px">' +
    keys.map(tf => {
      const engs = tfs[tf].engines||{};
      const engHtml = Object.keys(engs).map(k => {
        const e = engs[k];
        const n = {quant:'Quant',fvg:'FVG',crt:'CRT/TBS',smc:'SMC',trend:'Trend',ultimate:'Ultimate',hermes:'Hermes',sequoia:'Sequoia'};
        return `<div style="display:flex;justify-content:space-between;padding:2px 4px"><span>${n[k.toLowerCase()]||esc(k)}</span><span style="color:${e.direction==='BUY'?'var(--buy)':e.direction==='SELL'?'var(--sell)':'var(--text-muted)'}">${esc(e.direction)||'?'} ${e.confidence?(((e.confidence>1?e.confidence/100:e.confidence)*100).toFixed(0))+'%':''}</span></div>`;
      }).join('');
      return `<div style="margin-bottom:4px"><b>${esc(tf)}</b> ${engHtml}</div>`;
    }).join('') + '</div>';
  document.getElementById('engine-pulse').insertAdjacentHTML('beforeend', html);
}

// ── MAIN FETCH ──
async function fetchAll() {
  try {
    const [statsRes, bridgeRes, tradeLogRes] = await Promise.all([
      fetch(BRIDGE + '/api/dash-stats'),
      fetch(BRIDGE + '/status'),
      fetch(BRIDGE + '/api/trade-log')
    ]);
    const statsData = await statsRes.json();
    let bridgeData;
    try { bridgeData = await bridgeRes.json(); } catch(e) { bridgeData = {}; }
    let tradeLog;
    try { tradeLog = await tradeLogRes.json(); } catch(e) { tradeLog = []; }

    // Store trade log for rendering
    lastTradeLog = tradeLog || [];

    const trades = statsData.trades || [];
    const total = statsData.total || 0;
    const wins = statsData.wins || 0;
    const losses = statsData.losses || 0;
    const wr = statsData.win_rate || 0;
    const pnl = statsData.total_profit_usd || statsData.total_profit || 0;

    // ── Render Trade History ──
    renderTradeLog(tradeLog);

    // ── Price ──
    const xauPrice = statsData.xau_price || 0;
    if (xauPrice) {
      $('xau-price').textContent = '$' + parseFloat(xauPrice).toFixed(1);
      if (xauPrev && xauPrev !== xauPrice) {
        const diff = xauPrice - xauPrev;
        const cls = diff >= 0 ? 'up' : 'down';
        const icon = diff >= 0 ? '▲' : '▼';
        $('xau-change').innerHTML = '<span class="'+cls+'">'+icon+' '+Math.abs(diff).toFixed(2)+' ('+(diff/xauPrev*100).toFixed(2)+'%)</span>';
      } else if (firstRun) {
        $('xau-change').textContent = '$0.00 (0.00%)';
      }
      xauPrev = xauPrice;
    }

    // ── Bot Stats ──
    $('bot-winrate').textContent = wr ? wr.toFixed(1)+'%' : '0.0%';
    $('bot-winrate').style.color = wr>=50?'var(--buy)':wr>=30?'var(--gold)':'var(--sell)';
    $('bot-total').innerHTML = total+' total signals &middot; P&L '+fmtPnL(pnl);
    $('stat-wins').textContent = wins;
    $('stat-losses').textContent = losses;
    $('trade-count').textContent = total + ' total';

    if (trades.length) {
      const pipsArr = trades.map(t=>parseFloat(t.pips)||0).filter(p=>p!==0);
      if (pipsArr.length) {
        $('stat-best').textContent = fmtPips(Math.max(...pipsArr))+' pips';
        $('stat-worst').textContent = fmtPips(Math.min(...pipsArr))+' pips';
      }
    }

    let cw=0,cl=0;
    for (const t of trades) {
      const r = (t.outcome||t.result||'').toUpperCase();
      if (r.includes('TP')||r==='WIN'){cw++;cl=0;}
      else if (r.includes('SL')||r==='LOSS'){cl++;cw=0;}
      else {/* skip */}
    }
    $('stat-cwin').textContent=cw;
    $('stat-closs').textContent=cl;

    // ── Bridge ──
    const eaCount = bridgeData.ea_count||bridgeData.instance_count||0;
    const uptimeSec = bridgeData.uptime_seconds||0;
    const h = Math.floor(uptimeSec/3600), m = Math.floor((uptimeSec%3600)/60);
    const uptimeStr = h+'h '+m+'m';
    const queueSize = bridgeData.queue_size||0;
    $('bridge-ea').textContent = eaCount+(eaCount===1?' EA':' EAs');
    $('bridge-detail').innerHTML = uptimeStr+' uptime &middot; <span id="bridge-queue">'+queueSize+'</span> queued';

    // Session
    const hh = (new Date().getHours()+7)%24;
    const session = hh>=8&&hh<16?'Asian':hh>=16&&hh<21?'London':hh>=21||hh<2?'New York':'Pacific';
    $('xau-session').textContent = session+' Session';

    // ── AI Fundamental ──
    calcFundamental(xauPrice, trades);

    // ── Signal ──
    try {
      const signalRes = await fetch(BRIDGE + '/signal/pending?api_key=' + API_KEY,{signal:AbortSignal.timeout(4000)});
      const sig = await signalRes.json();
      const signalEl = $('signal-content');
      const sigIndicator = $('signal-indicator');
      if (sig && sig.action && sig.action!=='HOLD' && sig.pending) {
        const isBuy = sig.action === 'BUY';
        sigIndicator.className = 'sh-indicator active';
        sigIndicator.style.background = isBuy ? 'var(--buy)' : 'var(--sell)';
        $('signal-time').textContent = ts();
        const confidence = sig.confidence ? (sig.confidence>1 ? sig.confidence.toFixed(0) : (sig.confidence*100).toFixed(0))+'%' : '--';
        const rr = sig.rr_ratio ? '1:'+parseFloat(sig.rr_ratio).toFixed(1) : '--';
        const slDist = sig.sl&&sig.entry ? Math.abs(sig.sl-sig.entry).toFixed(1) : '--';
        signalEl.innerHTML = '<div style="margin-bottom:10px;font-size:12px;color:var(--text-muted);display:flex;gap:10px;flex-wrap:wrap"><span style="font-weight:700;'+(isBuy?'color:var(--buy)':'color:var(--sell)')+'">'+esc(sig.action)+'</span><span>'+esc(sig.symbol||'XAUUSD')+'</span><span>Conf: '+confidence+'</span><span>RR '+rr+'</span></div><div class="sg"><div class="si"><div class="sl">Entry</div><div class="sv '+(isBuy?'buy':'sell')+'">'+fmtPrice(sig.entry)+'</div></div><div class="si"><div class="sl">Stop Loss</div><div class="sv sell">'+fmtPrice(sig.sl)+' ('+slDist+' pt)</div></div><div class="si"><div class="sl">Take Profit</div><div class="sv buy">'+fmtPrice(sig.tp)+'</div></div><div class="si"><div class="sl">Risk/Reward</div><div class="sv" style="color:var(--gold)">'+rr+'</div></div>'+(sig.tp1?'<div class="si"><div class="sl">TP1</div><div class="sv">'+fmtPrice(sig.tp1)+'</div></div>':'')+(sig.tp2?'<div class="si"><div class="sl">TP2</div><div class="sv">'+fmtPrice(sig.tp2)+'</div></div>':'')+'</div>';
      } else {
        sigIndicator.className = 'sh-indicator idle';
        signalEl.innerHTML = '<div class="signal-empty"><div class="icon">📡</div><p>Waiting for market setup...</p></div>';
        $('signal-time').textContent = '';
      }
    } catch(e) { console.warn('Signal fetch failed:', e); sigIndicator.className = 'sh-indicator idle'; }
  } catch(e) {
    console.error('Dashboard error:', e);
  }
  firstRun = false;
}

// ── Refresh Loop ──
let countdown = 5;
function refreshLoop() {
  Promise.all([fetchAll(), fetchEnginePulse(), fetchNews()]).finally(() => {
    countdown = 5;
    const iv = setInterval(() => {
      countdown--;
      $('refresh-msg').textContent = 'Refreshing in '+countdown+'s';
      if (countdown <= 0) { clearInterval(iv); refreshLoop(); }
    }, 1000);
  });
}
refreshLoop();
</script>
</body>
</html>
