# bots/stockity-bot/.env.example
TELEGRAM_BOT_TOKEN=

# === Symbols (free sources, no auth) ===
# Forex:   EURUSD=X, GBPUSD=X, USDJPY=X, USDCHF=X, AUDUSD=X, USDCAD=X, NZDUSD=X
# Crypto:  BTC-USD, ETH-USD, SOL-USD, XRP-USD (via Binance — instant, no rate limits)
SYMBOLS=EURUSD=X,BTC-USD,ETH-USD

# === Stockity platform symbols (require WS auth from cookies) ===
STOCKITY_SYMBOLS=CRYPTO_IDX,BTC_IDX,ETH_IDX,GOLD_IDX

# === Stockity WebSocket auth — get from browser cookies at stockity.com/trading ===
STOCKITY_AUTH_TOKEN=
STOCKITY_USER_ID=

# === Binary options expiry timeframe (affects signal format only) ===
EXPIRY=1m

# === Scanner ===
SCAN_SECONDS=300
MIN_CONFIDENCE=62

# === Candle params ===
INTERVAL=1m
LOOKBACK_PERIOD=2d
