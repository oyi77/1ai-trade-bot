# =============================================================================
# tradebot Configuration — Copy to .env and fill in your values
# =============================================================================

# ── Deriv API Credentials ──
DERIV_APP_ID=33uQ6fU4eIRvJc6jkYeEa
DERIV_PAT_TOKEN=pat_your_pat_token_here
DERIV_ACCOUNT_ID=DOTyour_account_id
DERIV_API_TOKEN=
DERIV_MODE=demo

# ── Trading Parameters ──
DERIV_SYMBOL=R_75
DERIV_CONTRACT_TYPE=DIGITMATCH
DERIV_BARRIER=7
DERIV_INITIAL_STAKE=0.35
DERIV_STAKE_MULTIPLIER=1.55
DERIV_MAX_OPS=3
DERIV_MAX_STAKE_MULTIPLIER=10.0
DERIV_DURATION=1
DERIV_DURATION_UNIT=t
DERIV_TICK_HISTORY=100
DERIV_MIN_CONFIDENCE=0.3

# ── Risk Limits ──
DAILY_TAKE_PROFIT=5.0
DAILY_STOP_LOSS=-8.0
CONFIG_L_SL_POINTS=32.0
CONFIG_L_TP_POINTS=52.0
CONFIG_L_RR=1.625

# ── Pattern Analysis ──
TARGET_CARRIERS=1,2,3,4
MAX_JARING_TICKS=3
MIN_MOMEN1=1
MIN_MOMEN2=1
ANTI_FLOOD_WINDOW=20
ANTI_FLOOD_MAX=3
DEFAULT_MIN_THRESHOLD=3

# ── Cognitive / Actuary ──
PATTERN_BLACKLIST_HOURS=24
LATENCY_TRAP_MS=350
LATENCY_TRAP_LIMIT=2
MARKET_WIN_COOLDOWN_MIN=5
MARKET_LOSS_BLACKLIST_MIN=60
LOCK_TP_HOURS=12
LOCK_SL_HOURS=2
PAYOUT_MULTIPLIER=8.33
MAX_SHOTS=2

# ── Bridge Server ──
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8082

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Indonesian Stock Brokers ──
# Ajaib - https://ajaib.co.id
AJAIB_EMAIL=
AJAIB_PASSWORD=
AJAIB_DEVICE_ID=

# Pluang - https://pluang.com
PLUANG_API_KEY=
PLUANG_API_SECRET=

# Stockbit - https://stockbit.com
STOCKBIT_EMAIL=
STOCKBIT_PASSWORD=

# ── US Stock Broker ──
# Robinhood (unofficial API)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_DEVICE_TOKEN=

# ── Storage ──
DATA_DIR=

# ── Connection Tuning ──
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
WS_TIMEOUT=15
WS_MAX_SIZE=1048576
