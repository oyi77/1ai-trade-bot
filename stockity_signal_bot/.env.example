# Copy to .env and fill it.
# IMPORTANT: do not commit/share real Telegram tokens.
TELEGRAM_BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# Comma-separated Yahoo Finance symbols. Pick assets that are also available in Stockity.
SYMBOLS=EURUSD=X,GBPUSD=X,USDJPY=X,BTC-USD,ETH-USD,GC=F,CL=F

# Signal settings
INTERVAL=1m
LOOKBACK_PERIOD=2d
SCAN_SECONDS=300
MIN_CONFIDENCE=62
