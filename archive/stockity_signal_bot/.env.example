# Copy to .env and fill it.
# IMPORTANT: do not commit/share real Telegram tokens.
TELEGRAM_BOT_TOKEN=PLACE_TELEGRAM_BOT...

# Comma-separated Yahoo Finance symbols (standard market data)
SYMBOLS=EURUSD=X,GBPUSD=X,USDJPY=X,BTC-USD,ETH-USD,GC=F,CL=F

# Comma-separated Stockity platform-native symbols (requires WS auth)
STOCKITY_SYMBOLS=CRYPTO_IDX

# Stockity WebSocket auth — from browser cookies after logging in
# Open DevTools → Application → Cookies → stockity.com → copy values
STOCKITY_AUTH_TOKEN=
STOCKITY_USER_ID=

# Signal settings
INTERVAL=1m
LOOKBACK_PERIOD=2d
SCAN_SECONDS=300
MIN_CONFIDENCE=62
